# PowerShell: set these environment variables before python -m webapp.
DB_LAB_SERVER=localhost\SQLEXPRESS
DB_LAB_APP_DATABASE=TokenHubDB_v11_WebYourSuffix
DB_LAB_SECRET=generate-a-private-random-value
DB_LAB_PORT=5050
# Required only when creating the isolated sample database, never committed:
DB_LAB_DEMO_PASSWORD=set-locally-at-least-12-bytes
